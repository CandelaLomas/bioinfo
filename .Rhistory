# FILTROS PARA GENES PARCIALMENTE CONTENIDOS (solapamiento)
f1 <- gff$seqid == 'JAJSEB010000048.1' & gff$end >= 184638 & gff$start <= 253478
f2 <- gff$seqid == 'JAJSEB010000012.1' & gff$end >= 133444 & gff$start <= 348860
f3 <- gff$seqid == 'JAJSEB010000020.1' & gff$end >= 73393  & gff$start <= 149614
f4 <- gff$seqid == 'JAJSEB010000016.1' & gff$end >= 161247 & gff$start <= 272009
f5 <- gff$seqid == 'JAJSEB010000033.1' & gff$end >= 123135 & gff$start <= 170687
# Combinar filtros
f_parcial <- f1 | f2 | f3 | f4 | f5
# Aplicar filtro
genes_parciales <- gff[f_parcial & gff$type == "gene", ]
# Ver resultados
cat("=== GENES PARCIALMENTE CONTENIDOS ===\n")
cat("Número de genes que solapan:", nrow(genes_parciales), "\n")
# Genes completamente contenidos (filtro original)
f_completo <- (gff$seqid == 'JAJSEB010000048.1' & gff$start >= 184638 & gff$end <= 253478) |
(gff$seqid == 'JAJSEB010000012.1' & gff$start >= 133444 & gff$end <= 348860) |
(gff$seqid == 'JAJSEB010000020.1' & gff$start >= 73393  & gff$end <= 149614) |
(gff$seqid == 'JAJSEB010000016.1' & gff$start >= 161247 & gff$end <= 272009) |
(gff$seqid == 'JAJSEB010000033.1' & gff$start >= 123135 & gff$end <= 170687)
genes_completos <- gff[f_completo & gff$type == "gene", ]
# Comparación
cat("\n=== COMPARACIÓN ===\n")
cat("Genes completamente contenidos:", nrow(genes_completos), "\n")
cat("Genes parcialmente contenidos (solapan):", nrow(genes_parciales), "\n")
cat("Diferencia:", nrow(genes_parciales) - nrow(genes_completos), "genes adicionales\n")
# Para ver ejemplos de genes que ahora se incluyen
if (nrow(genes_parciales) > nrow(genes_completos)) {
# Encontrar genes que están en parciales pero no en completos
ids_completos <- rownames(genes_completos)
ids_parciales <- rownames(genes_parciales)
nuevos <- setdiff(ids_parciales, ids_completos)
cat("\n=== EJEMPLOS DE GENES PARCIALMENTE CONTENIDOS ===\n")
print(genes_parciales[rownames(genes_parciales) %in% nuevos[1:min(5, length(nuevos))],
c("seqid", "start", "end", "type")])
}
# Construir la URL para la consulta a ENA
portal <- 'https://www.ebi.ac.uk/ena/portal/api/search?'
result <- 'result=assembly&'
query  <- 'query=tax_tree(5690)&'  # 5690 = Trypanosoma
fields <- 'fields=accession%2Cversion%2Cscientific_name%2Cbase_count%2Clast_updated%2Cassembly_level'
URL <- paste0(portal, result, query, fields)
# Descargar datos
genomas.ena <- read.table(URL, header = TRUE, sep = '\t', quote = '', na.strings = '')
# Ver estructura
cat("=== DATOS DE ENA ===\n")
dim(genomas.ena)
names(genomas.ena)
head(genomas.ena)
# Ver nuestros datos de NCBI (los que creamos antes)
cat("\n=== DATOS DE NCBI ===\n")
dim(genomas)
names(genomas)
head(genomas$Assembly.Accession)
# Notar que los accession de NCBI tienen sufijo (.1, .2, etc.)
# Mientras que los de ENA no tienen sufijo
# Explicación de sapply() + strsplit():
# strsplit() divide "GCA_022059095.1" en "GCA_022059095" y "1"
# sapply(..., '[', 1) extrae el primer elemento (la parte sin versión)
genomas$acc <- sapply(
strsplit(genomas$Assembly.Accession, '.', fixed = TRUE),
'[', 1
)
# Ver resultado
cat("\n=== ACCESSION SIN VERSIÓN ===\n")
head(data.frame(
original = genomas$Assembly.Accession,
sin_version = genomas$acc
), 10)
# match(genomas$acc, genomas.ena$accession) devuelve:
# - La posición en genomas.ena de cada accession de genomas
# - NA si no hay coincidencia
# Ejemplo simple de cómo funciona match()
ejemplo <- match(c("A", "B", "C", "D"), c("D", "B", "A", "E"))
# resultado: 3 2 NA 1
# Aplicar a nuestros datos
posiciones <- match(genomas$acc, genomas.ena$accession)
# Añadir columna last_updated desde ENA
genomas$last_updated <- genomas.ena[posiciones, 'last_updated']
# Ver resultado
cat("\n=== DATOS COMBINADOS ===\n")
head(genomas[, c("Assembly.Accession", "acc", "last_updated")], 20)
# Estadísticas de coincidencias
cat("\n=== ESTADÍSTICAS DE COINCIDENCIAS ===\n")
cat("Total genomas NCBI:", nrow(genomas), "\n")
cat("Total genomas ENA:", nrow(genomas.ena), "\n")
cat("Coincidencias (tienen last_updated):", sum(!is.na(genomas$last_updated)), "\n")
cat("Sin coincidencia en ENA:", sum(is.na(genomas$last_updated)), "\n")
# Ver ejemplos sin coincidencia
if (any(is.na(genomas$last_updated))) {
cat("\nEjemplos sin coincidencia:\n")
print(genomas[is.na(genomas$last_updated),
c("Assembly.Accession", "acc", "Organism.Name")])
}
library(kableExtra)
# Crear tabla con los que tienen fecha
con_fecha <- genomas[!is.na(genomas$last_updated),
c("Assembly.Accession", "Organism.Name", "last_updated")]
kable(head(con_fecha, 20),
col.names = c("Accession", "Organismo", "Última actualización (ENA)"),
caption = "Genomas de Trypanosoma con fecha de actualización en ENA") %>%
kable_styling(full_width = FALSE, bootstrap_options = "striped")
# COMPROBACIÓN 1: ¿Hay valores duplicados?
cat("=== VERIFICACIÓN DE LLAVE ===\n")
# Número total de filas
cat("Total filas en genomas:", nrow(genomas), "\n")
# Número de valores únicos en acc
cat("Valores únicos en acc:", length(unique(genomas$acc)), "\n")
# ¿Son iguales? Si sí, es llave
es_llave <- nrow(genomas) == length(unique(genomas$acc))
cat("¿acc es llave?", es_llave, "\n")
# Si no es llave, encontrar duplicados
if (!es_llave) {
# Encontrar accession duplicados
duplicados <- genomas$acc[duplicated(genomas$acc)]
cat("\n⚠️  ACCESSION DUPLICADOS:\n")
for (acc in unique(duplicados)) {
cat("\n", acc, ":\n")
print(genomas[genomas$acc == acc,
c("Assembly.Accession", "Organism.Name")])
}
# Explicación de por qué ocurre
cat("\n--- EXPLICACIÓN ---\n")
cat("Diferentes versiones del mismo ensamblaje (.1, .2, etc.)\n")
cat("Ahora comparten el mismo acc sin versión\n")
cat("En este caso, acc NO es llave, sino que agrupa versiones\n")
} else {
cat("\n✅ ¡Perfecto! acc sigue siendo llave única\n")
}
# COMPROBACIÓN 2: ¿Hay NA?
cat("\n¿Valores NA en acc?", any(is.na(genomas$acc)), "\n")
# ============================================================
# AÑADIR BASE_COUNT Y COMPARAR
# ============================================================
# 1. Añadir base_count desde ENA usando match()
genomas$base_count <- genomas.ena[match(genomas$acc, genomas.ena$accession), 'base_count']
# 2. Ver las nuevas columnas
cat("=== COMPARACIÓN DE LONGITUDES ===\n")
head(genomas[, c("Assembly.Accession", "acc",
"Assembly.Stats.ATGC.Count", "base_count")], 20)
# 3. Crear data frame para comparación
comparacion <- data.frame(
accession = genomas$Assembly.Accession,
acc_sin_version = genomas$acc,
ncbi_length = genomas$Assembly.Stats.ATGC.Count,
ena_length = as.numeric(genomas$base_count),  # asegurar numérico
stringsAsFactors = FALSE
)
# 4. Calcular diferencias
comparacion$diferencia <- comparacion$ncbi_length - comparacion$ena_length
comparacion$dif_relativa <- round(comparacion$diferencia / comparacion$ena_length * 100, 2)
# 5. Análisis de diferencias
cat("\n=== ANÁLISIS DE DIFERENCIAS ===\n")
cat("Coinciden exactamente:", sum(comparacion$diferencia == 0, na.rm = TRUE), "\n")
cat("Difieren:", sum(comparacion$diferencia != 0, na.rm = TRUE), "\n")
cat("Sin datos en ENA:", sum(is.na(comparacion$ena_length)), "\n")
# 6. Ver casos con diferencia
if (any(comparacion$diferencia != 0, na.rm = TRUE)) {
cat("\n--- CASOS CON DIFERENCIA (top 10) ---\n")
diffs <- comparacion[!is.na(comparacion$ena_length) &
comparacion$diferencia != 0, ]
diffs <- diffs[order(abs(diffs$diferencia), decreasing = TRUE), ]
print(head(diffs, 10))
}
# 7. Resumen estadístico de diferencias
cat("\n--- RESUMEN DE DIFERENCIAS ---\n")
summary(comparacion$diferencia[!is.na(comparacion$ena_length)])
# 8. Visualización
par(mfrow = c(1, 2))
# Histograma de diferencias
hist(comparacion$diferencia[!is.na(comparacion$ena_length)],
breaks = 30,
main = "Diferencias NCBI vs ENA",
xlab = "Diferencia (pb)",
col = "skyblue")
# Scatter plot
plot(comparacion$ncbi_length, comparacion$ena_length,
main = "NCBI vs ENA",
xlab = "NCBI length (pb)",
ylab = "ENA length (pb)",
pch = 19, col = rgb(0,0,1,0.5))
abline(0, 1, col = "red", lwd = 2)  # línea de igualdad
# Ver el primer valor de attributes en gene
gene[1, 'attributes']
# Ver los primeros 3 para comparar
gene[1:3, 'attributes']
# strsplit() divide la cadena por el separador ';'
strsplit(gene[1, 'attributes'], ';')
# strsplit() aplicado a múltiples filas (devuelve una lista)
strsplit(gene[1:3, 'attributes'], ';')
# Guardar todos los atributos en una lista
atributos <- strsplit(gene[ , 'attributes'], ';')
# Ver estructura
cat("=== ESTRUCTURA DE 'atributos' ===\n")
cat("Tipo de objeto:", class(atributos), "\n")
cat("Longitud de la lista:", length(atributos), "\n")
cat("Primeros elementos:\n")
head(atributos)
# Convertir cada vector de "clave=valor" en un vector con nombres
atributos2 <- lapply(
atributos,
function(x) {
# x es un vector de atributos de un gen (ej: c("ID=gene1", "Name=BRCA", ...))
lista <- strsplit(x, '=')  # Dividir cada "clave=valor"
# lista es una lista de vectores: [[1]] c("ID", "gene1"), [[2]] c("Name", "BRCA")...
valores <- sapply(lista, '[', 2)  # Extraer los valores (segundo elemento)
names(valores) <- sapply(lista, '[', 1)  # Poner las claves como nombres
return(valores)
}
)
# Ver resultado
cat("\n=== ATRIBUTOS PROCESADOS ===\n")
cat("Primeros elementos de atributos2:\n")
head(atributos2)
# Ver un elemento específico
cat("\nEjemplo (primer gen):\n")
print(atributos2[[1]])
# Extraer cada campo y añadirlo como columna
gene$ID           <- sapply(atributos2, '[', 'ID')
gene$Name         <- sapply(atributos2, '[', 'Name')
gene$gene_biotype <- sapply(atributos2, '[', 'gene_biotype')
gene$locus_tag    <- sapply(atributos2, '[', 'locus_tag')
# Verificar que se añadieron
cat("\n=== NUEVAS COLUMNAS AÑADIDAS ===\n")
names(gene)
library(kableExtra)
# Seleccionar todas las columnas excepto 'attributes'
f <- names(gene) != 'attributes'
# Mostrar tabla con las nuevas columnas
kable(gene[1:15, f],
caption = "Genes con atributos extraídos como columnas",
format = "html") %>%
kable_styling(full_width = FALSE, bootstrap_options = c("striped", "hover")) %>%
scroll_box(height = "400px")
# Ver qué campos existen en los atributos
todos_los_campos <- unique(unlist(lapply(atributos2, names)))
cat("\n=== CAMPOS DISPONIBLES EN 'attributes' ===\n")
print(todos_los_campos)
# Para cada campo, ver cuántos genes lo tienen
for (campo in todos_los_campos) {
num_con_campo <- sum(!is.na(sapply(atributos2, '[', campo)))
cat(sprintf("%-15s: %d genes (%.1f%%)\n",
campo, num_con_campo, num_con_campo/nrow(gene)*100))
}
# Extraer automáticamente todos los campos
for (campo in todos_los_campos) {
nombre_columna <- make.names(campo)  # convertir a nombre válido de columna
gene[[nombre_columna]] <- sapply(atributos2, '[', campo)
}
# Ver todas las nuevas columnas
cat("\n=== TODAS LAS COLUMNAS DE GENE ===\n")
names(gene)
q()
