# Mostrar información de los genes
if (nrow(genes_regiones) > 0) {
genes_info <- data.frame(
Region = c(rep("R1", sum(f1 & gff$type == "gene")),
rep("R2", sum(f2 & gff$type == "gene")),
rep("R3", sum(f3 & gff$type == "gene")),
rep("R4", sum(f4 & gff$type == "gene")),
rep("R5", sum(f5 & gff$type == "gene"))),
Cromosoma = genes_regiones$seqid,
Inicio = genes_regiones$start,
Fin = genes_regiones$end,
Longitud = genes_regiones$end - genes_regiones$start + 1,
Hebra = genes_regiones$strand
)
print(genes_info)
}
