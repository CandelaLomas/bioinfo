bootstrap_options = c("striped", "hover", "condensed")) %>%
row_spec(0, bold = TRUE, background = "#2c3e50", color = "white")
# Guardar
writeLines(as.character(tabla_dplyr), "resumen_dplyr.html")
cat("Tabla guardada en:", file.path(getwd(), "resumen_dplyr.html"))
writeLines(as.character(tabla_dplyr), "resumen_dplyr.html")
cat("Tabla guardada en:", file.path(getwd(), "resumen_dplyr.html"))
library(dplyr)
library(kableExtra)
# Asegurarnos de que tenemos el data frame 'gene'
# Si no existe, lo creamos a partir de gff
if (!exists("gene")) {
gene <- gff[gff$type == "gene", ]
}
# Solución al desafío
genes_por_cromosoma <- gene %>%
group_by(seqid, strand) %>%
summarise(
num_genes = n(),
.groups = 'drop'
) %>%
arrange(seqid, strand)  # ordenar para mejor visualización
# Ver la tabla
print(genes_por_cromosoma)
# Tabla bonita con kable
kable(genes_por_cromosoma,
col.names = c('Cromosoma/Contig', 'Hebra (strand)', 'Número de genes'),
caption = 'Desafío: Genes por cromosoma y hebra',
align = 'lcr') %>%
kable_styling(full_width = FALSE,
bootstrap_options = c("striped", "hover")) %>%
row_spec(0, bold = TRUE, background = "#2c3e50", color = "white")
# Usando split para separar por cromosoma y hebra
genes_por_grupo <- split(gene, list(gene$seqid, gene$strand))
# Crear data frame con los resultados
genes_base <- data.frame(
cromosoma = sapply(strsplit(names(genes_por_grupo), "\\."), `[`, 1),
hebra = sapply(strsplit(names(genes_por_grupo), "\\."), `[`, 2),
num_genes = sapply(genes_por_grupo, nrow)
)
# Eliminar grupos vacíos (si los hay)
genes_base <- genes_base[genes_base$num_genes > 0, ]
# Ordenar
genes_base <- genes_base[order(genes_base$cromosoma, genes_base$hebra), ]
# Ver resultado
print(genes_base)
# Guardar la tabla principal del desafío
tabla_desafio <- kable(genes_por_cromosoma,
col.names = c('Cromosoma', 'Hebra', 'Nº genes'),
format = "html",
caption = "Desafío: Distribución de genes por cromosoma y hebra") %>%
kable_styling(full_width = FALSE, bootstrap_options = "striped") %>%
row_spec(0, bold = TRUE, background = "#2c3e50", color = "white")
writeLines(as.character(tabla_desafio), "desafio_genes_por_cromosoma.html")
cat("✅ Tabla guardada en:", file.path(getwd(), "desafio_genes_por_cromosoma.html"))
