caption = "Genes en cromosomas candidatos (primeros 50)",
format = "html") %>%
kable_styling(full_width = FALSE, bootstrap_options = "striped") %>%
scroll_box(height = "400px")
writeLines(as.character(tabla_candidatos), "genes_candidatos.html")
