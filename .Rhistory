print(table(interesantes$type))
# 5. Ver las primeras filas
head(interesantes)
# Función para extraer ID de genes de la columna attributes
extraer_id <- function(attr) {
# Buscar patrón ID=...;
id_match <- regexpr("ID=[^;]+", attr)
ifelse(id_match > 0,
regmatches(attr, id_match),
NA_character_)
}
# Aplicar a los genes candidatos
genes_candidatos$gene_id <- extraer_id(genes_candidatos$attributes)
# Ver tabla resumen
resumen_candidatos <- data.frame(
Cromosoma = genes_candidatos$seqid,
Inicio = genes_candidatos$start,
Fin = genes_candidatos$end,
Longitud = genes_candidatos$end - genes_candidatos$start + 1,
Hebra = genes_candidatos$strand,
ID = genes_candidatos$gene_id
)
# Mostrar
kable(head(resumen_candidatos, 20),
caption = "Primeros genes en cromosomas candidatos") %>%
kable_styling(full_width = FALSE)
# ¿Qué porcentaje del genoma representan estos cromosomas?
total_anotaciones <- nrow(gff)
porcentaje <- nrow(interesantes) / total_anotaciones * 100
cat("\n=== COMPARACIÓN CON TOTAL ===\n")
cat("Total anotaciones en genoma:", total_anotaciones, "\n")
cat("Anotaciones en cromosomas candidatos:", nrow(interesantes), "\n")
cat("Porcentaje:", round(porcentaje, 2), "%\n")
# Comparar tipos de anotación
tabla_comparacion <- rbind(
total = table(gff$type),
candidatos = table(interesantes$type)
)
print(tabla_comparacion)
# Guardar lista de genes candidatos
write.csv(genes_candidatos, "genes_candidatos.csv", row.names = FALSE)
# Crear tabla HTML
