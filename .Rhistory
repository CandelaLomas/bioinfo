# 1. Crear los filtros booleanos para cada región
f1 <- gff$seqid == 'JAJSEB010000048.1' & gff$start >= 184638 & gff$end <= 253478
f2 <- gff$seqid == 'JAJSEB010000012.1' & gff$start >= 133444 & gff$end <= 348860
f3 <- gff$seqid == 'JAJSEB010000020.1' & gff$start >= 73393  & gff$end <= 149614
f4 <- gff$seqid == 'JAJSEB010000016.1' & gff$start >= 161247 & gff$end <= 272009
f5 <- gff$seqid == 'JAJSEB010000033.1' & gff$start >= 123135 & gff$end <= 170687
# 2. Combinar todos los filtros con OR (|)
f <- f1 | f2 | f3 | f4 | f5
# 3. Aplicar el filtro al data frame gff
regiones_candidatas <- gff[f, ]
# 4. Ver resultados
cat("=== RESULTADOS ===\n")
cat("Total de anotaciones en regiones candidatas:", nrow(regiones_candidatas), "\n")
cat("\nTipos de anotaciones encontradas:\n")
print(table(regiones_candidatas$type))
# 5. Ver las primeras filas
head(regiones_candidatas)
# Ver cuántas anotaciones hay en cada región
cat("\n=== ANOTACIONES POR REGIÓN ===\n")
cat("Región 1 (JAJSEB010000048.1:184638-253478):", sum(f1), "\n")
cat("Región 2 (JAJSEB010000012.1:133444-348860):", sum(f2), "\n")
cat("Región 3 (JAJSEB010000020.1:73393-149614):", sum(f3), "\n")
cat("Región 4 (JAJSEB010000016.1:161247-272009):", sum(f4), "\n")
cat("Región 5 (JAJSEB010000033.1:123135-170687):", sum(f5), "\n")
# Tabla de tipos por región
tipos_region <- data.frame(
Region = c(rep("R1", sum(f1)), rep("R2", sum(f2)),
rep("R3", sum(f3)), rep("R4", sum(f4)),
rep("R5", sum(f5))),
Tipo = regiones_candidatas$type
)
print(table(tipos_region))
# Filtrar solo genes
genes_regiones <- regiones_candidatas[regiones_candidatas$type == "gene", ]
cat("\n=== GENES EN REGIONES CANDIDATAS ===\n")
