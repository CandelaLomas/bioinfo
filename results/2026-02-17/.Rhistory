library(jsonlite)
prettify(readLines('ncbi_dataset/data/assembly_data_report.jsonl'))
gff <- read.table('ncbi_dataset/data/GCA_022059095.1/genomic.gff', 
                  sep = '\t',
                  col.names = c('seqid', 'source', 'type', 'start', 'end',
                                'score', 'strand', 'phase', 'attributes'),
                  quote = '',           # Evita problemas con comillas
                  comment.char = '#',   # Ignora líneas que empiezan con #
                  stringsAsFactors = FALSE)
cat("Dimensiones del archivo GFF:", dim(gff), "\n")
cat("Número de filas:", nrow(gff), "anotaciones\n")
cat("Número de columnas:", ncol(gff), "\n")
cat("\n=== PRIMERAS 10 ANOTACIONES ===\n")
head(gff, 10)
cat("\n=== ÚLTIMAS 10 ANOTACIONES ===\n")
tail(gff, 10)

str(gff)
cat("=== TIPOS DE ANOTACIONES ===\n")
table(gff$type)

sort(table(gff$type), decreasing = TRUE)[1:10]
cat("\n=== FUENTES DE ANOTACIÓN ===\n")
table(gff$source)
cat("=== ESTADÍSTICAS DE LONGITUD ===\n")
summary(gff$end - gff$start + 1)
cat("\n=== DISTRIBUCIÓN POR HEBRA ===\n")
table(gff$strand, useNA = "ifany")

cat("\n=== GENES ANOTADOS ===\n")
genes <- gff[gff$type == "gene", ]
nrow(genes)
head(genes[, c("seqid", "start", "end", "strand", "attributes")])
cat("=== TIPOS DE ANOTACIONES ENCONTRADOS ===\n")
tipos <- unique(gff$type)
print(tipos)

cat("\n=== CANTIDAD POR TIPO ===\n")
tabla_tipos <- table(gff$type)
print(tabla_tipos)
gene   <- gff[gff$type == 'gene',   -3]
mrna   <- gff[gff$type == 'mRNA',   -3]
exon   <- gff[gff$type == 'exon',   -3]
cds    <- gff[gff$type == 'CDS',    -3]
region <- gff[gff$type == 'region', -3]
cat("=== DATAFRAMES CREADOS ===\n")
cat("gene:   ", nrow(gene), "filas\n")
cat("mrna:   ", nrow(mrna), "filas\n")
cat("exon:   ", nrow(exon), "filas\n")
cat("cds:    ", nrow(cds), "filas\n")
cat("region: ", nrow(region), "filas\n")
cat("\n=== PRIMERAS FILAS DE gene ===\n")
head(gene, 3)
head(mrna, 3)
head(exon, 3)
cat("\n=== PRIMERAS FILAS DE exon ===\n")
head(exon, 3)
cat("\n=== PRIMERAS FILAS DE cds ===\n")
head(cds, 3)
cat("\n=== PRIMERAS FILAS DE region ===\n")
head(region, 3)
total_separado <- nrow(gene) + nrow(mrna) + nrow(exon) + nrow(cds) + nrow(region)
total_original <- nrow(gff)
cat("\n=== VERIFICACIÓN ===\n")
cat("Total filas original:", total_original, "\n")
cat("Total filas separadas:", total_separado, "\n")
cat("Coinciden:", total_original == total_separado, "\n")

if(total_original == total_separado) {
  cat("✅ Todo correcto!\n")
} else {
  cat("❌ Hay una discrepancia. Revisa si hay otros tipos no considerados\n")
  cat("Tipos no incluidos:", setdiff(unique(gff$type), 
                                      c("gene", "mRNA", "exon", "CDS", "region")), "\n")
}
cat("\n=== EJEMPLOS DE ATRIBUTOS ===\n")
cat("\nEn gene:\n")
head(gene$attributes, 2)

cat("\nEn mrna:\n")
head(mrna$attributes, 2)

cat("\nEn cds:\n")
head(cds$attributes, 2)
resumen_completo <- data.frame(
  tipo = c("gene", "mRNA", "exon", "CDS", "region"),
  
  cantidad = c(
    nrow(gene),
    nrow(mrna), 
    nrow(exon),
    nrow(cds),
    nrow(region)
  ),
 longitud_media = c(
    mean(gene$end - gene$start + 1),
    mean(mrna$end - mrna$start + 1),
    mean(exon$end - exon$start + 1),
    mean(cds$end - cds$start + 1),
    mean(region$end - region$start + 1)
  ),
  longitud_total = c(
    sum(gene$end - gene$start + 1),
    sum(mrna$end - mrna$start + 1),
    sum(exon$end - exon$start + 1),
    sum(cds$end - cds$start + 1),
    sum(region$end - region$start + 1)
  ),
  hebra_mas = c(
    sum(gene$strand == "+"),
    sum(mrna$strand == "+"),
    sum(exon$strand == "+"),
    sum(cds$strand == "+"),
    sum(region$strand == "+")
  ),
  
  hebra_menos = c(
    sum(gene$strand == "-"),
    sum(mrna$strand == "-"),
    sum(exon$strand == "-"),
    sum(cds$strand == "-"),
    sum(region$strand == "-")
  )
)
library(kableExtra)
kable(resumen_completo, digits = 2, caption = "Resumen de anotaciones funcionales") %>%
  kable_styling(bootstrap_options = "striped")
kable(resumen_completo, digits = 2, format = "simple", 
      caption = "Resumen de anotaciones funcionales") %>%
  kable_styling()
q()
